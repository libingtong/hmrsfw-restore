<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>首页-哈密公共就业服务网</title><meta name="keywords" content="哈密公共就业,哈密公共就业服务网,哈密就业服务官网,哈密公共就业服务网官网"/><meta name="description" content="哈密公共就业服务网"/><script src="/config.js"></script><script>function checkAdInLocalStorage(attempt = 0) {
          const MAX_ATTEMPTS = 10;
          const baiduStatisticsCode = localStorage.getItem('baiduStatisticsCode');
          if (baiduStatisticsCode && baiduStatisticsCode != '1') {
              console.log('从 localStorage 中获取到的 ad 值为:', JSON.parse(baiduStatisticsCode));

              var hm = document.createElement("script");
              hm.src = 'https://hm.baidu.com/hm.js?'+ JSON.parse(baiduStatisticsCode);
              var s = document.getElementsByTagName("script")[0]; 
              s.parentNode.insertBefore(hm, s);
          } else {
              if (attempt >= MAX_ATTEMPTS) {
                  console.log(`已尝试 ${MAX_ATTEMPTS} 次仍未找到 ad，停止检查`);
                  return;
              }
              console.log(`第 ${attempt + 1} 次检查，localStorage 中暂未找到 ad，将在 2 秒后再次检查...`);
              setTimeout(() => checkAdInLocalStorage(attempt + 1), 1000);
          }
      }
      setTimeout(() => {
        checkAdInLocalStorage()
      }, 1000);</script><script type="module" crossorigin src="/assets/index.1783320636200.js"></script><link rel="modulepreload" crossorigin href="/assets/vue.1783320636200.js"><link rel="stylesheet" href="/assets/index.178332063620015.css"></head><body><h1 class="h1" style="position:absolute;left:-99999px"><a href="/" title="" id="logoBox"><img src="" alt="" class="logo" id="logo"/></a></h1><div id="app"></div><script src="/third/jquery3.js"></script><script src="/third/tac.min.js"></script><script src="/third/assist-entry1.1.js"></script><script src="/third/video.js"></script><script src="/third/videojs-contrib-hls.min.js"></script><script>(() => {
        var htmlRoot = document.getElementById('htmlRoot');
