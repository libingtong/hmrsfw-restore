# 加解密密钥：复制为 skeleton/.env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不得提交）。
# 两个应用（portal / uc）共用这一份，vite 配置里 envDir 指向 skeleton/。
# 值来自后端 platform/jeecg-boot-base-core：SM2 公钥对应 Sm2Util 的私钥，SM4 密钥对应 Sm4Utils.KEY。

# SM2 公钥，十六进制，压缩（02/03 开头，66 位）或非压缩（04 开头，130 位）均可；请求体加密用
VITE_HMRSFW_SM2_PUBLIC_KEY=
# SM4 密钥，32 位十六进制；响应解密用
VITE_HMRSFW_SM4_KEY=
# 浏览器存储用的 SM4 密钥，32 位十六进制；留空则沿用 VITE_HMRSFW_SM4_KEY
VITE_HMRSFW_SM4_STORAGE_KEY=
VITE_BMAP_AK=
